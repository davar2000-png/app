// Mobile Phone Shop Manager - Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id                        String   @id @default(uuid())
  shopName                  String   @default("فروشگاه موبایل")
  shopPhone                 String?
  shopAddress               String?
  logo                      String?
  defaultInputCurrency      String   @default("TOMAN")
  defaultReportCurrency     String   @default("RIAL")
  purchaseInvoicePrefix     String   @default("PUR-")
  salesInvoicePrefix        String   @default("SAL-")
  salesReturnPrefix         String   @default("SRN-")
  purchaseReturnPrefix      String   @default("PRN-")
  installmentContractPrefix String   @default("INS-")
  checkPrefix               String   @default("CHK-")
  promissoryNotePrefix      String   @default("PNT-")
  registerMovementPrefix    String   @default("REG-")
  allowNegativeStock        Boolean  @default(false)
  enableLateFee             Boolean  @default(false)
  lateFeePercentage         Float    @default(0.0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model Product {
  id                   String   @id @default(uuid())
  type                 String   @default("MOBILE") // MOBILE, ACCESSORY, SERVICE
  brand                String?
  category             String?
  modelName            String
  color                String?
  storage              String?
  condition            String   @default("NEW") // NEW, USED, OPEN_BOX, REFURBISHED, DAMAGED
  barcode              String?  @unique
  description          String?
  requiresSerial       Boolean  @default(false)
  defaultPurchasePrice BigInt
  defaultSalePrice     BigInt
  minStock             Int      @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  serialNumbers       SerialNumber[]
  purchaseItems       PurchaseItem[]
  saleItems           SaleItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleReturnItems     SaleReturnItem[]
  stockMovements      StockMovement[]
}

model SerialNumber {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  serialValue  String   @unique
  status       String   @default("IN_STOCK") // IN_STOCK, RESERVED, SOLD, RETURNED, DAMAGED, REMOVED_BY_ADJUSTMENT
  purchaseCost BigInt
  salePrice    BigInt?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseItemId String?
  purchaseItem   PurchaseItem?   @relation(fields: [purchaseItemId], references: [id])
  saleItemId     String?
  saleItem       SaleItem?       @relation(fields: [saleItemId], references: [id])
  stockMovements StockMovement[]
}

model Supplier {
  id         String   @id @default(uuid())
  name       String
  phone      String?
  address    String?
  nationalId String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  purchases PurchaseInvoice[]
  Payment   Payment[]
}

model Customer {
  id         String   @id @default(uuid())
  name       String
  phone      String?
  address    String?
  nationalId String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sales                SalesInvoice[]
  installmentContracts InstallmentContract[]
  checks               CheckInstrument[]
  promissoryNotes      PromissoryNoteInstrument[]
  Payment              Payment[]
}

model PurchaseInvoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  purchaseDate  DateTime
  totalAmount   BigInt
  paymentStatus String   @default("UNPAID") // PAID, UNPAID, PARTIALLY_PAID
  status        String   @default("DRAFT") // DRAFT, CONFIRMED, RETURNED, VOID
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items   PurchaseItem[]
  returns PurchaseReturn[]
}

model PurchaseItem {
  id                String          @id @default(uuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  quantity          Int
  unitPrice         BigInt
  totalPrice        BigInt
  createdAt         DateTime        @default(now())

  serialNumbers SerialNumber[]
}

model PurchaseReturn {
  id                String          @id @default(uuid())
  returnNumber      String          @unique
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  returnDate        DateTime
  totalAmount       BigInt
  reason            String?
  status            String          @default("CONFIRMED")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items PurchaseReturnItem[]
}

model PurchaseReturnItem {
  id               String         @id @default(uuid())
  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  quantity         Int
  unitPrice        BigInt
  totalPrice       BigInt
  createdAt        DateTime       @default(now())
}

model StockMovement {
  id            String        @id @default(uuid())
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  serialId      String?
  serial        SerialNumber? @relation(fields: [serialId], references: [id])
  movementType  String // PURCHASE_IN, PURCHASE_RETURN_OUT, SALE_OUT, SALE_RETURN_IN, ADJUSTMENT_IN, ADJUSTMENT_OUT
  quantity      Int
  referenceType String
  referenceId   String
  notes         String?
  createdAt     DateTime      @default(now())
}

model SalesInvoice {
  id             String    @id @default(uuid())
  invoiceNumber  String    @unique
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  saleDate       DateTime
  subtotal       BigInt
  discountAmount BigInt    @default(0)
  totalAmount    BigInt
  paymentStatus  String    @default("UNPAID")
  status         String    @default("DRAFT") // DRAFT, CONFIRMED, RETURNED, VOID
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items                SaleItem[]
  returns              SaleReturn[]
  installmentContracts InstallmentContract[]
}

model SaleItem {
  id             String       @id @default(uuid())
  salesInvoiceId String
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Int
  unitPrice      BigInt
  discountAmount BigInt       @default(0)
  totalPrice     BigInt
  costPrice      BigInt
  createdAt      DateTime     @default(now())

  serialNumbers SerialNumber[]
}

model SaleReturn {
  id             String       @id @default(uuid())
  returnNumber   String       @unique
  salesInvoiceId String
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
  returnDate     DateTime
  totalAmount    BigInt
  reason         String?
  status         String       @default("CONFIRMED")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items SaleReturnItem[]
}

model SaleReturnItem {
  id           String     @id @default(uuid())
  saleReturnId String
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  unitPrice    BigInt
  totalPrice   BigInt
  costPrice    BigInt
  createdAt    DateTime   @default(now())
}

model Payment {
  id            String    @id @default(uuid())
  paymentNumber String    @unique
  paymentType   String // CASH, MANUAL_CARD, CHECK, PROMISSORY_NOTE, INSTALLMENT, CUSTOMER_CREDIT, SUPPLIER_PAYMENT
  amount        BigInt
  paymentDate   DateTime
  description   String?
  referenceType String
  referenceId   String
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  createdAt     DateTime  @default(now())

  registerMovement RegisterMovement? @relation(fields: [paymentId], references: [id])
  paymentId        String?           @unique
}

model InstallmentContract {
  id                   String       @id @default(uuid())
  contractNumber       String       @unique
  salesInvoiceId       String
  salesInvoice         SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
  customerId           String
  customer             Customer     @relation(fields: [customerId], references: [id])
  downPayment          BigInt
  totalAmount          BigInt
  remainingAmount      BigInt
  numberOfInstallments Int
  interval             String       @default("MONTHLY") // WEEKLY, MONTHLY, CUSTOM
  intervalDays         Int?
  firstDueDate         DateTime
  status               String       @default("PENDING") // PENDING, PARTIALLY_PAID, PAID, OVERDUE, SETTLED, CANCELLED
  notes                String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  schedules InstallmentSchedule[]
  payments  InstallmentPayment[]
}

model InstallmentSchedule {
  id                String              @id @default(uuid())
  contractId        String
  contract          InstallmentContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  installmentNumber Int
  dueDate           DateTime
  amount            BigInt
  paidAmount        BigInt              @default(0)
  remainingAmount   BigInt
  status            String              @default("PENDING")
  paidAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  payments InstallmentPayment[]
}

model InstallmentPayment {
  id          String              @id @default(uuid())
  scheduleId  String
  schedule    InstallmentSchedule @relation(fields: [scheduleId], references: [id])
  contractId  String
  contract    InstallmentContract @relation(fields: [contractId], references: [id])
  amount      BigInt
  paymentDate DateTime
  notes       String?
  createdAt   DateTime            @default(now())
}

model CheckInstrument {
  id               String    @id @default(uuid())
  instrumentNumber String    @unique
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id])
  bankName         String?
  dueDate          DateTime
  amount           BigInt
  status           String    @default("PENDING") // PENDING, COLLECTED, BOUNCED, RETURNED, TRANSFERRED, CANCELLED
  linkedInvoiceId  String?
  linkedContractId String?
  collectedAt      DateTime?
  bouncedAt        DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  registerMovement RegisterMovement? @relation(fields: [checkMovementId], references: [id])
  checkMovementId  String?           @unique
}

model PromissoryNoteInstrument {
  id               String    @id @default(uuid())
  instrumentNumber String    @unique
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id])
  dueDate          DateTime
  amount           BigInt
  status           String    @default("PENDING")
  linkedInvoiceId  String?
  linkedContractId String?
  collectedAt      DateTime?
  bouncedAt        DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  registerMovement     RegisterMovement? @relation(fields: [promissoryMovementId], references: [id])
  promissoryMovementId String?           @unique
}

model RegisterMovement {
  id             String   @id @default(uuid())
  movementNumber String   @unique
  movementType   String // CASH_SALE, MANUAL_CARD_RECEIPT, CUSTOMER_PAYMENT, SUPPLIER_PAYMENT, CHECK_COLLECTED, MANUAL_DEPOSIT, MANUAL_WITHDRAWAL, ADJUSTMENT
  amount         BigInt
  movementDate   DateTime @default(now())
  description    String?
  referenceType  String?
  referenceId    String?
  balanceAfter   BigInt
  createdAt      DateTime @default(now())

  payment         Payment?
  checkInstrument CheckInstrument?
  promissoryNote  PromissoryNoteInstrument?
}

model Account {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  type      String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  category  String   @unique
  balance   BigInt   @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalLines JournalLine[]
}

model JournalEntry {
  id            String   @id @default(uuid())
  entryNumber   String   @unique
  entryDate     DateTime @default(now())
  description   String?
  referenceType String
  referenceId   String
  isBalanced    Boolean  @default(true)
  isReversed    Boolean  @default(false)
  reversedBy    String?
  createdAt     DateTime @default(now())

  lines JournalLine[]
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          BigInt
  credit         BigInt
  description    String?
  createdAt      DateTime     @default(now())
}
