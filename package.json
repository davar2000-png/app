{
  "name": "mobile-shop-manager",
  "version": "1.0.0",
  "private": true,
  "description": "سیستم حسابداری فروشگاه تکنوکالا",
  "author": "davar2000-png",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "desktop:dev": "cross-env NODE_ENV=development electron .",
    "desktop:dist": "npm run build && electron-builder --win nsis --x64"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0", "@dnd-kit/sortable": "^8.0.0", "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1", "@prisma/client": "^5.22.0", "@supabase/supabase-js": "^2.98.0",
    "bcryptjs": "^3.0.3", "canvas-confetti": "^1.9.3", "date-fns": "^2.30.0", "date-fns-jalali": "^4.4.0-0",
    "framer-motion": "^11.16.1", "lucide-react": "^0.294.0", "next": "^16.3.5", "react": "^19.3.0",
    "react-dom": "^19.3.0", "react-hook-form": "^7.88.0", "recharts": "^2.10.0", "uuid": "^9.0.1",
    "xlsx": "^0.18.5", "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6", "@types/node": "^26.5.1", "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0", "@types/uuid": "^9.0.7", "autoprefixer": "^10.6.0",
    "cross-env": "^7.0.3", "electron": "^38.0.0", "electron-builder": "^26.0.12",
    "postcss": "^8.5.28", "prisma": "^5.22.0", "tailwindcss": "^4.3.3", "tsx": "^4.23.13", "typescript": "^5.9.3"
  },
  "build": {
    "appId": "ir.technokala.accounting", "productName": "TechnoKala Accounting", "asar": true,
    "asarUnpack": ["node_modules/.prisma/**/*", "node_modules/@prisma/client/**/*"],
    "files": [".next/**/*", "public/**/*", "electron/**/*", "package.json", "node_modules/**/*"],
    "extraResources": [{ "from": "prisma", "to": "prisma" }],
    "directories": { "output": "release" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "حسابداری تکنوکالا" }
  }
}
